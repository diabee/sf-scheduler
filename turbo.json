{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:frontend-only": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "start:prod": {}
  },
  "dangerouslyDisablePackageManagerCheck": true,
  "ui": "tui"
}
